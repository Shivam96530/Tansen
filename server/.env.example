# Injected automatically by Render. Do not hardcode in db.
PORT=5001
NODE_ENV=production
# Genius API key for metadata / lyrics matching
GENIUS_API_KEY=
# Hugging Face server-side key. Never expose with VITE_
HF_TOKEN=
# Supported chat model served via router.huggingface.co/v1
HF_CHAT_MODEL=Qwen/Qwen3-32B:fastest
# Flask stream engine
STREAM_BASE_URL=
# Production origin for browser CORS when the API is called from a different domain
# APP_ORIGIN=https://tansen-7vfq.onrender.com
